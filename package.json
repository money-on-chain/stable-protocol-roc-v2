{
  "name": "roc-sc-protocol-v2",
  "version": "1.1.0",
  "private": true,
  "homepage": "https://www.moneyonchain.com",
  "description": "Money on Chain main smart contract protocol RIF implementation",
  "author": "MOC Investments Corp. 2020",
  "license": "AGPL-3.0",
  "dependencies": {
    "hardhat": "2.20.1",
    "hardhat-deploy": "0.14.00",
    "hardhat-storage-layout": "0.1.7",
    "moc-main": "github:money-on-chain/main-sc-protocol-v2#v1.1.1-beta",
    "moc-main-v1.0.6": "github:money-on-chain/main-sc-protocol-v2#v1.0.7-rc",
    "solc": "0.8.24"
  },
  "devDependencies": {
    "@commitlint/cli": "17.6.3",
    "@commitlint/config-conventional": "17.6.3",
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@nomicfoundation/hardhat-verify": "2.0.13",
    "@nomiclabs/hardhat-solhint": "4.0.1",
    "@openzeppelin-v4.8.0/contracts": "npm:@openzeppelin/contracts@4.8.0",
    "@openzeppelin-v4.8.0/contracts-upgradeable": "npm:@openzeppelin/contracts-upgradeable@4.8.0",
    "@openzeppelin/contracts": "4.9.3",
    "@openzeppelin/contracts-upgradeable": "4.9.3",
    "@openzeppelin/hardhat-upgrades": "3.9.0",
    "@tenderly/hardhat-tenderly": "2.5.2",
    "@types/chai": "4.3.5",
    "@types/fs-extra": "11.0.4",
    "@types/node": "22.13.5",
    "@typescript-eslint/eslint-plugin": "5.59.7",
    "@typescript-eslint/parser": "5.59.7",
    "dotenv": "16.4.7",
    "eslint": "8.41.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-no-only-tests": "3.1.0",
    "eslint-plugin-prettier": "5.2.5",
    "ethers": "6.13.5",
    "hardhat-contract-sizer": "2.10.0",
    "hardhat-docgen": "1.3.0",
    "hardhat-erc1820": "0.1.0",
    "hardhat-preprocessor": "0.1.5",
    "hardhat-storage-layout-diff": "0.0.4",
    "husky": "8.0.3",
    "prettier": "3.5.3",
    "prettier-plugin-solidity": "1.4.2",
    "solhint": "5.0.5",
    "solhint-plugin-prettier": "0.1.0",
    "standard-version": "9.5.0",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.7.3"
  },
  "comments": {
    "dependencies": "hardhat-solhint and hardhat-prettier includes old versions, that's why specific dependencies are added",
    "hardhat": "hardhat version fixed to 2.20.1 because known issue with forks https://github.com/NomicFoundation/hardhat/issues/5511#issuecomment-2223268992"
  },
  "types": "types/index.d.ts",
  "files": [
    "/contracts"
  ],
  "keywords": [
    "blockchain",
    "ethereum",
    "hardhat",
    "smart-contracts",
    "solidity",
    "rsk"
  ],
  "scripts": {
    "prepare": "husky install",
    "clean": "hardhat clean",
    "typechain": "TS_NODE_TRANSPILE_ONLY=true hardhat --config ./hardhat.base.config.ts typechain",
    "compile": "npm run typechain && hardhat compile",
    "lint": "npm run lint:ts && npm run prettier:check",
    "lint:ts": "eslint --config ./.eslintrc.yaml --ignore-path ./.eslintignore \"**/*.{js,ts}\"",
    "lint-fix": "eslint --fix --config ./.eslintrc.yaml --ignore-path ./.eslintignore \"**/*.{js,ts}\"",
    "prettier": "prettier --config .prettierrc --write \"**/*.{js,json,md,sol,ts,yml}\"",
    "prettier:check": "prettier --config .prettierrc --check \"**/*.{js,json,md,sol,ts,yml}\"",
    "release": "standard-version",
    "docgen": "hardhat docgen",
    "test": "hardhat test --typecheck",
    "deploy-localhost": "hardhat deploy --tags MultiCollateralUpgradeChanger",
    "deploy-rskTestnet": "hardhat deploy --network rskTestnet --tags MultiCollateralUpgradeChanger",
    "deploy-rskMainnet": "hardhat deploy --network rskMainnet --tags MultiCollateralUpgradeChanger",
    "etherscan-verify:rskTestnet": "hardhat --network rskTestnet etherscan-verify --solc-input",
    "tenderly-verify:rskTestnet": "npx hardhat run scripts/tenderly-verify.ts --network rskTestnet"
  }
}
