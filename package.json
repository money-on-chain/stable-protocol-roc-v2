{
  "name": "roc-sc-protocol-v2",
  "version": "3.2.1",
  "private": true,
  "homepage": "https://www.moneyonchain.com",
  "description": "Money on Chain main smart contract protocol RIF implementation",
  "author": "MOC Investments Corp. 2020",
  "license": "AGPL-3.0",
  "dependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "solc": "0.8.24"
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@eslint/js": "9.27.0",
    "@moc/flow": "git+ssh://git@github.com/money-on-chain/MoC-Flow.git#v3.0.3",
    "@moc/moc-main": "git+ssh://git@github.com/money-on-chain/main-sc-protocol-v2.git#v3.0.9",
    "@moc/oracles": "git+ssh://git@github.com/money-on-chain/OMoC-Decentralized-Oracle.git#v3.0.11",
    "@moc/periphery": "git+ssh://git@github.com/money-on-chain/MoC-Periphery#v3.0.5",
    "@moc/price-oracle-interfaces": "git+ssh://git@github.com/money-on-chain/price_oracle_interfaces.git#v0.1.0",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-viem": "3.1.6",
    "@nomicfoundation/hardhat-keystore": "3.0.12",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "3.0.17",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@nomicfoundation/hardhat-verify": "3.0.21",
    "@nomicfoundation/hardhat-viem": "3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "3.1.2",
    "@nomicfoundation/ignition-core": "3.1.8",
    "@openzeppelin-v4.8.0/contracts": "npm:@openzeppelin/contracts@4.8.0",
    "@openzeppelin-v4.8.0/contracts-upgradeable": "npm:@openzeppelin/contracts-upgradeable@4.8.0",
    "@openzeppelin/contracts": "4.9.3",
    "@openzeppelin/contracts-upgradeable": "4.9.3",
    "@openzeppelin/defender-deploy-client-cli": "0.0.1-alpha.10",
    "@openzeppelin/foundry-upgrades": "0.4.0",
    "@openzeppelin/upgrades-core": "1.46.0",
    "@solidstate/hardhat-contract-sizer": "^3.0.3",
    "@types/chai": "5.2.3",
    "@types/fs-extra": "11.0.4",
    "@types/node": "22.15.21",
    "@uniswap/swap-router-contracts": "1.3.1",
    "dotenv": "16.4.7",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-prettier": "5.5.5",
    "forge-std": "github:foundry-rs/forge-std#v1.9.7",
    "hardhat": "3.9.0",
    "husky": "9.1.7",
    "ignition-utils": "git+https://github.com/money-on-chain/ignition-utils.git#v1.0.0",
    "moc-main-latest": "git+ssh://git@github.com/money-on-chain/main-sc-protocol-v2#v3.0.9",
    "prettier": "3.8.1",
    "prettier-plugin-solidity": "1.4.2",
    "solhint": "5.0.5",
    "solhint-plugin-prettier": "0.1.0",
    "standard-version": "9.5.0",
    "ts-test-helpers": "git+ssh://git@github.com/money-on-chain/ts-test-helpers#v0.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "viem": "2.53.1"
  },
  "comments": {
    "dependencies": "hardhat-solhint and hardhat-prettier includes old versions, that's why specific dependencies are added",
    "hardhat": "Migrated to Hardhat 3.x - ESM-first, declarative config"
  },
  "main": "./dist/addressBook.js",
  "types": "./dist/addressBook.d.ts",
  "exports": {
    ".": {
      "types": "./dist/addressBook.d.ts",
      "import": "./dist/addressBook.js",
      "default": "./dist/addressBook.js"
    },
    "./addressBook": {
      "types": "./dist/addressBook.d.ts",
      "import": "./dist/addressBook.js",
      "default": "./dist/addressBook.js"
    },
    "./addressBook.json": "./addressBook.json",
    "./contracts": "./contracts",
    "./contracts/*": "./contracts/*",
    "./ignition": "./dist/ignition",
    "./ignition/modules/changers/addTasksRunner/parameters/*": "./ignition/modules/changers/addTasksRunner/parameters/*",
    "./ignition/modules/changers/fixInfinityAndDOCRName/parameters/*": "./ignition/modules/changers/fixInfinityAndDOCRName/parameters/*",
    "./ignition/modules/changers/preTasksRunner/parameters/*": "./ignition/modules/changers/preTasksRunner/parameters/*",
    "./ignition/modules/changers/pauserSplitRifProMigrationChanger/parameters/*": "./ignition/modules/changers/pauserSplitRifProMigrationChanger/parameters/*",
    "./ignition/deployments/*": "./ignition/deployments/*",
    "./ignition/*": "./dist/ignition/*",
    "./config/solidity": {
      "types": "./dist/config/solidity.d.ts",
      "import": "./dist/config/solidity.js",
      "default": "./dist/config/solidity.js"
    },
    "./types": "./types",
    "./types/*": "./types/*"
  },
  "files": ["dist", "contracts", "ignition", "addressBook.js", "addressBook.d.ts", "addressBook.json", "types"],
  "keywords": ["blockchain", "ethereum", "hardhat", "smart-contracts", "solidity", "rsk"],
  "scripts": {
    "hooks:install": "husky",
    "clean": "hardhat clean && rm -rf dist cache out artifacts",
    "compile": "hardhat build",
    "build:local": "pnpm clean && pnpm compile && pnpm exec tsc -p tsconfig.json",
    "quality": "pnpm format:check && pnpm lint && pnpm check",
    "check": "pnpm exec tsc --noEmit -p tsconfig.json",
    "format": "pnpm exec prettier ./test/* --write",
    "format:check": "pnpm exec prettier ./test/* --check",
    "lint": "pnpm exec eslint . --max-warnings 0",
    "lint:fix": "pnpm exec eslint . --fix --max-warnings 0",
    "release": "standard-version",
    "test": "npx hardhat test solidity",
    "test:storage": "FOUNDRY_PROFILE=storage forge clean && FOUNDRY_PROFILE=storage forge build --force && FOUNDRY_PROFILE=storage forge test -vv",
    "test:tasksRunner": "./scripts/changers/addTasksRunner/run-fork-tests.sh",
    "test:fork:mainnet": "hardhat test solidity -vvv",
    "test:all": "pnpm run test && npm run test:storage",
    "merge-params": "node scripts/changers/multiCollateralUpgrade/merge-ignition-params.mjs",
    "deploy-pauser-split-rifpro-migration-rskTestnet": "npx hardhat ignition deploy ./ignition/modules/changers/pauserSplitRifProMigrationChanger/PauserSplitRifProMigrationChanger.ts --network rskTestnet --parameters ./ignition/modules/changers/pauserSplitRifProMigrationChanger/parameters/rskTestnet.json",
    "deploy-pauser-split-rifpro-migration-rskMainnet": "npx hardhat ignition deploy ./ignition/modules/changers/pauserSplitRifProMigrationChanger/PauserSplitRifProMigrationChanger.ts --network rskMainnet --parameters ./ignition/modules/changers/pauserSplitRifProMigrationChanger/parameters/rskMainnet.json",
    "deploy-preTasksRunner-rskMainnet": "npx hardhat ignition deploy ./ignition/modules/changers/preTasksRunner/preTasksRunner.ts --network rskMainnet --build-profile default --parameters ./ignition/modules/changers/preTasksRunner/parameters/rskMainnet.json --deployment-id preTasksRunner-mainnet",
    "verify:rskTestnet": "pnpm hardhat ignition verify --network rskTestnet",
    "verify:rskMainnet": "pnpm hardhat ignition verify --network rskMainnet chain-30",
    "tenderly-verify:rskTestnet": "pnpm hardhat run scripts/tenderly-verify.ts --network rskTestnet"
  },
  "type": "module",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "peerDependencies": {
    "@moc/flow": "3.0.3",
    "@moc/oracles": "3.0.11",
    "@moc/price-oracle-interfaces": "0.1.0",
    "@nomicfoundation/hardhat-verify": "^3.0.0",
    "hardhat": "^3.8.0",
    "ignition-utils": "1.0.0",
    "moc-main-latest": "3.0.9"
  }
}
